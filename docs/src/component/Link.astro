---
import { Icon } from 'astro-icon/components';

import { isExternalHref } from "../plugins/rehype/linkAugmentation.ts";
import type { Link } from "../type";

interface Props {
    link: Link;
    download?: boolean;
}

const { link, download = false } = Astro.props;

const isExternal = isExternalHref(link.url);
const icon = download ? "arrow-down" : (isExternal ? "arrow-up-right" : "arrow-right");
---
<a
    href={link.url}
    class="link-component hover:underline"
    target={isExternal && !download ? "_blank" : undefined}
    rel={isExternal && !download ? "noopener noreferrer" : undefined}
    download={download ? "" : undefined}
>
    {link.name}&hairsp;<span class="link-component-icon-wrap"><Icon name={icon} class="link-component-icon" aria-hidden="true" /></span>
</a>

<style>
    .link-component {
        display: inline;
        align-self: start;
        color: var(--color-blue-700);
        border-radius: 0.15em;
    }
    @media (prefers-color-scheme: dark) {
        .link-component {
            color: var(--color-blue-500);
        }
    }
    .link-component:focus {
        outline: none;
    }
    .link-component:focus-visible {
        outline: 2px solid var(--color-focus);
        outline-offset: 2px;
        border-radius: 0.15em;
    }
    .link-component-icon-wrap {
        display: inline-flex;
        align-items: center;
        line-height: 0;
        vertical-align: middle;
    }
    .link-component-icon {
        width: 1.33em;
        height: 1.33em;
    }
</style>