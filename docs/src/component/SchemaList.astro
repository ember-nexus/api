---
import { allSchemas, prime } from '../lib/collections.ts';
import { schemaPath } from '../lib/routes.ts';

await prime();
const schemas = allSchemas();
---
<ul class="not-prose sl-list">
    {schemas.map((s) => (
        <li>
            <a href={schemaPath(s.id)} class="sl-link">
                <code class="sl-name">{s.name}</code>
            </a>
        </li>
    ))}
</ul>

<style>
    .sl-list {
        list-style: none;
        margin: 0;
        padding: 0;
        display: flex;
        flex-direction: column;
        gap: 0.25rem;
    }

    .sl-list li {
        margin: 0;
        padding: 0;
    }

    .sl-link {
        display: block;
        border-radius: 0.375rem;
        padding: 0.5rem 0.75rem;
        border: 1px solid var(--color-hairline);
        text-decoration: none;
        color: inherit;
        transition: background-color 0.15s ease;
    }

    .sl-link:hover {
        background-color: var(--c-list-link-hover-bg);
    }

    .sl-link:focus-visible {
        outline: 2px solid var(--color-focus);
        outline-offset: 2px;
    }

    .sl-name {
        font-family: var(--font-mono);
        font-size: 0.8125rem;
        color: var(--c-list-code-fg);
        background: none;
        padding: 0;
        border: none;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        display: block;
    }

    /* Dark-mode list-link colors are handled via --c-list-* vars in colors.css */
</style>
