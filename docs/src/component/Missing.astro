---
// Inline "this cell does not apply" marker — the counterpart to `Check.astro`
// for comparison tables. Markdown counterpart: `src/mdmx/registry/Missing.ts`
// (renders `➖`).
import { Icon } from 'astro-icon/components';
---
<Icon
    name="minus"
    class="inline-block size-4 align-text-bottom text-gray-400 dark:text-gray-600"
    aria-label="no"
/>
