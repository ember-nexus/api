---
interface Props {
    href: string;
}
const { href } = Astro.props;
---
<a href={href} class="link-card">
    <p class="link-card__title"><slot name="title" /></p>
    <p class="link-card__subtitle"><slot name="description" /></p>
</a>

<style>
    .link-card {
        display: flex;
        flex-direction: column;
        gap: 0.25rem;
        height: 100%;                 /* equal row heights */
        padding: 1rem;
        border: 1px solid var(--color-hairline);
        border-radius: var(--radius-lg, 0.5rem);
        text-decoration: none;        /* beats .prose a underline */
        color: inherit;               /* beats .prose a blue */
        transition: background-color 0.15s ease, border-color 0.15s ease;
    }

    .link-card:hover {
        background-color: var(--color-neutral-50);
    }

    .link-card:focus-visible {
        outline: 2px solid var(--color-focus);
        outline-offset: 2px;
    }

    .link-card__title {
        margin: 0;
        font-size: 1.125rem;
        font-weight: 500;
        line-height: 1.3;
        color: var(--color-neutral-900);
        overflow-wrap: anywhere;      /* break long identifiers */
        text-wrap: pretty;
    }

    .link-card__subtitle {
        margin: 0;
        font-family: var(--font-mono);
        font-size: 0.8125rem;
        color: var(--color-neutral-500);
        overflow-wrap: anywhere;
    }

    @media (prefers-color-scheme: dark) {
        .link-card:hover {
            background-color: var(--color-neutral-900);
        }
        .link-card__title {
            color: var(--color-neutral-100);
        }
    }
</style>
