{
  "openapi": "3.1.1",
  "info": {
    "title": "Ember Nexus API",
    "description": "Knowledge graph API with advanced search capabilities.",
    "version": "0.1.31",
    "license": {
      "name": "Source First License 1.1",
      "url": "https://github.com/ember-nexus/api/blob/main/LICENSE"
    },
    "contact": {
      "name": "GitHub issues",
      "url": "https://github.com/ember-nexus/api/issues"
    }
  },
  "servers": [
    {
      "url": "https://reference-dataset.ember-nexus.dev/",
      "description": "Demo API instance running the reference dataset backup."
    }
  ],
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "Bearer token for user authentication. If omitted, the request is processed as an anonymous user; if provided, the associated user account is used.",
        "x-ember-nexus-links": [
          {
            "url": "https://developer.mozilla.org/en-US/docs/Web/HTTP/Reference/Headers/Authorization",
            "name": "MDN"
          },
          {
            "url": "https://http.dev/authorization",
            "name": "HTTP.dev"
          },
          {
            "url": "/guide/authentication",
            "name": "Authentication guide"
          }
        ]
      }
    }
  }
}
