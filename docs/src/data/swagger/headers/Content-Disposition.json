{
  "components": {
    "headers": {
      "Content-Disposition": {
        "description": "Provides the original filename, as well as additional file attributes. Non-ASCII filenames can be encoded using UTF-8, but require special escape sequences - see spec/docs for details.",
        "schema": {
          "type": "string",
          "example": "attachment; filename=image.jpg"
        },
        "x-ember-nexus-links": [
          {
            "url": "https://developer.mozilla.org/en-US/docs/Web/HTTP/Headers/Content-Disposition",
            "name": "MDN"
          },
          {
            "url": "https://http.dev/content-disposition",
            "name": "HTTP.dev"
          }
        ],
        "x-ember-nexus-important": true,
        "required": true
      }
    }
  }
}
