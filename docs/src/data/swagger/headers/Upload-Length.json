{
  "components": {
    "headers": {
      "Upload-Length": {
        "description": "Total number of bytes the finished file will have. Optional - omitted when the total size is not known ahead of time.",
        "schema": {
          "type": "integer",
          "example": 20971520
        },
        "x-ember-nexus-links": [
          {
            "url": "https://datatracker.ietf.org/doc/draft-ietf-httpbis-resumable-upload/",
            "name": "IETF draft"
          },
          {
            "url": "https://http.dev/upload-length",
            "name": "HTTP.dev"
          }
        ],
        "x-ember-nexus-important": true,
        "required": false
      }
    }
  }
}
