{
  "paths": {
    "/search": {
      "post": {
        "responses": {
          "422": {
            "description": "The request content was syntactically valid, but could not be processed due to a configured resource limit, e.g. an expression (Go Expr Lang) query exceeding its configured timeout.",
            "headers": {
              "Access-Control-Allow-Headers": {
                "$ref": "#/components/headers/Access-Control-Allow-Headers"
              },
              "Access-Control-Allow-Methods": {
                "$ref": "#/components/headers/Access-Control-Allow-Methods"
              },
              "Access-Control-Allow-Origin": {
                "$ref": "#/components/headers/Access-Control-Allow-Origin"
              },
              "Access-Control-Expose-Headers": {
                "$ref": "#/components/headers/Access-Control-Expose-Headers"
              },
              "Allow": {
                "$ref": "#/components/headers/Allow"
              },
              "Cache-Control": {
                "$ref": "#/components/headers/Cache-Control"
              },
              "X-Powered-By": {
                "$ref": "#/components/headers/X-Powered-By"
              }
            },
            "x-ember-nexus-links": [
              {
                "url": "https://developer.mozilla.org/en-US/docs/Web/HTTP/Reference/Status/422",
                "name": "MDN"
              },
              {
                "url": "https://http.dev/422",
                "name": "HTTP.dev"
              }
            ],
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                },
                "examples": {
                  "expressionTimeout": {
                    "$ref": "#/components/examples/UnprocessableContentProblemExample"
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
