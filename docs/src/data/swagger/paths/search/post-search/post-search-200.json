                    "x-ember-nexus-recording": "search/example/element-hydration/explicit-elementids-hydration/response-body.json"
                  },
                  "cypherPathSubsetFindTaggedElements": {
                    "summary": "Cypher path subset search for tagged elements, hydrated into a collection of elements.",
                    "x-ember-nexus-name": "Find Tagged Elements",
                    "x-ember-nexus-recording": "search/example/cypher-path-subset/find-tagged-elements/response-body.json"
                  }
