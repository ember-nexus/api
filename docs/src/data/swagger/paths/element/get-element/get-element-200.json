                  },
                  "relationship": {
                    "summary": "Element found, which happens to be a relation.\n\n**Note**: The properties `start` and `end` are defined, as they are required for relations.",
                    "x-ember-nexus-name": "Relation",
                    "x-ember-nexus-recording": "api-endpoints/element/get-element/200-relation-response-body.json"
                  }
                }
              }
            }
          }
        }
      }
    }
  }
