{
  "paths": {
    "/{uuid}/children": {
      "get": {
        "responses": {
          "404": {
            "description": "Element does not exist, or the current user does not have permissions to access the element.",
            "headers": {
              "Access-Control-Allow-Headers": {
                "$ref": "#/components/headers/Access-Control-Allow-Headers"
              },
              "Access-Control-Allow-Methods": {
                "$ref": "#/components/headers/Access-Control-Allow-Methods"
              },
              "Access-Control-Allow-Origin": {
                "$ref": "#/components/headers/Access-Control-Allow-Origin"
              },
              "Access-Control-Expose-Headers": {
                "$ref": "#/components/headers/Access-Control-Expose-Headers"
              },
              "Allow": {
                "$ref": "#/components/headers/Allow"
              },
              "Cache-Control": {
                "$ref": "#/components/headers/Cache-Control"
              },
              "X-Powered-By": {
                "$ref": "#/components/headers/X-Powered-By"
              }
            },
            "x-ember-nexus-links": [
              {
                "url": "https://developer.mozilla.org/en-US/docs/Web/HTTP/Reference/Status/404",
                "name": "MDN"
              },
              {
                "url": "https://http.dev/404",
                "name": "HTTP.dev"
              }
            ],
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                },
                "examples": {
                  "notFound": {
                    "$ref": "#/components/examples/NotFoundProblemExample"
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
