{
  "paths": {
    "/instance-configuration": {
      "get": {
        "responses": {
          "200": {
            "description": "Returns the instance's configuration parameters and limits.",
            "headers": {
              "Access-Control-Allow-Headers": {
                "$ref": "#/components/headers/Access-Control-Allow-Headers"
              },
              "Access-Control-Allow-Methods": {
                "$ref": "#/components/headers/Access-Control-Allow-Methods"
              },
              "Access-Control-Allow-Origin": {
                "$ref": "#/components/headers/Access-Control-Allow-Origin"
              },
              "Access-Control-Expose-Headers": {
                "$ref": "#/components/headers/Access-Control-Expose-Headers"
              },
              "Allow": {
                "$ref": "#/components/headers/Allow"
              },
              "Cache-Control": {
                "$ref": "#/components/headers/Cache-Control"
              },
              "X-Powered-By": {
                "$ref": "#/components/headers/X-Powered-By"
              }
            },
            "x-ember-nexus-links": [
              {
                "url": "https://developer.mozilla.org/en-US/docs/Web/HTTP/Reference/Status/200",
                "name": "MDN"
              },
              {
                "url": "https://http.dev/200",
                "name": "HTTP.dev"
              }
            ],
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InstanceConfiguration"
                },
                "examples": {
                  "instanceConfiguration": {
                    "value": {
                      "version": "0.1.31",
                      "pageSize": {
                        "min": 5,
                        "default": 25,
                        "max": 100
                      },
                      "register": {
                        "enabled": true,
                        "uniqueIdentifier": "email",
                        "uniqueIdentifierRegex": false
                      },
                      "expression": {
                        "enabled": true,
                        "maxLength": 10240
                      },
                      "file": {
                        "maxFileSizeInBytes": 10737418240,
                        "uploadExpiresInSecondsAfterFirstRequest": 10800,
                        "uploadMinChunkSizeInBytes": 5242880,
                        "uploadMaxChunkSizeInBytes": 105906176
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
