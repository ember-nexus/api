{
  "paths": {
    "/{uuid}/file": {
      "delete": {
        "summary": "Delete element file",
        "description": "Deletes the file attached to an element, along with the file-related metadata on the element itself. Does not delete the element.",
        "operationId": "delete-element-file",
        "tags": [
          "File"
        ],
        "security": [
          {
            "BearerAuth": []
          },
          {}
        ],
        "parameters": [
          {
            "name": "uuid",
            "in": "path",
            "required": true,
            "description": "Element id: a UUIDsv2a7 (draft-davis-uuidrev-uuid-long-00) with 16 random bytes, encoded as base62sort (37 characters); the base16-and-dash representation is accepted as well.",
            "schema": {
              "type": "string",
              "pattern": "^(?:[0-9A-Za-z]{37}|[0-9A-Fa-f]{8}-[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{12}-[0-9A-Fa-f]{14})$"
            },
            "description": "Id of the element whose file is to be deleted."
          }
        ],
        "x-ember-nexus-har-example": [
          {
            "har": {
              "method": "DELETE",
              "url": "https://api.example.com/02IiNr0GOoKiPMM569f95VLLfjRVJ1JriLYcy/file",
              "httpVersion": "HTTP/1.1",
              "cookies": [],
              "headers": [
                {
                  "name": "Authorization",
                  "value": "Bearer secret-token:PIPeJGUt7c00ENn8a5uDlc"
                }
              ],
              "queryString": [],
              "headersSize": -1,
              "bodySize": -1
            }
          }
        ]
      }
    }
  }
}
