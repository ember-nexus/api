                    "$ref": "#/components/examples/OffsetMismatchProblemExample"
                  },
                  "uploadLocked": {
                    "$ref": "#/components/examples/UploadLockedProblemExample"
                  }
                }
              }
            }
          }
        }
      }
    }
  }
