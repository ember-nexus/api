{
  "paths": {
    "/upload/{uuid}": {
      "delete": {
        "summary": "Delete upload",
        "description": "Aborts a resumable upload: already-uploaded chunks are removed from storage and the upload itself ceases to exist. The target element is left untouched. Only the user who created the upload can delete it.",
        "operationId": "delete-upload",
        "tags": [
          "File"
        ],
        "security": [
          {
            "BearerAuth": []
          },
          {}
        ],
        "parameters": [
          {
            "name": "uuid",
            "in": "path",
            "required": true,
            "description": "Element id: a UUIDsv2a7 (draft-davis-uuidrev-uuid-long-00) with 16 random bytes, encoded as base62sort (37 characters); the base16-and-dash representation is accepted as well.",
            "schema": {
              "type": "string",
              "pattern": "^(?:[0-9A-Za-z]{37}|[0-9A-Fa-f]{8}-[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{12}-[0-9A-Fa-f]{14})$"
            },
            "description": "Id of the resumable upload, as returned in the `Location` header of the request that created it."
          }
        ],
        "x-ember-nexus-har-example": [
          {
            "har": {
              "method": "DELETE",
              "url": "https://api.example.com/upload/02IiNr0GOoKiPMM569f95VLLfjRVJ1JriLYcy",
              "httpVersion": "HTTP/1.1",
              "cookies": [],
              "headers": [
                {
                  "name": "Authorization",
                  "value": "Bearer secret-token:PIPeJGUt7c00ENn8a5uDlc"
                }
              ],
              "queryString": [],
              "headersSize": -1,
              "bodySize": -1
            }
          }
        ]
      }
    }
  }
}
