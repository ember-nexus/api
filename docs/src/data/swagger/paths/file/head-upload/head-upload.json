{
  "paths": {
    "/upload/{uuid}": {
      "head": {
        "summary": "Head upload",
        "description": "Retrieves the current state of a resumable upload without transferring any of its already-uploaded data. Only the user who created the upload can query it.",
        "operationId": "head-upload",
        "tags": [
          "File"
        ],
        "security": [
          {
            "BearerAuth": []
          },
          {}
        ],
        "parameters": [
          {
            "name": "uuid",
            "in": "path",
            "required": true,
            "description": "Element id: a UUIDsv2a7 (draft-davis-uuidrev-uuid-long-00) with 16 random bytes, encoded as base62sort (37 characters); the base16-and-dash representation is accepted as well.",
            "schema": {
              "type": "string",
              "pattern": "^(?:[0-9A-Za-z]{37}|[0-9A-Fa-f]{8}-[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{12}-[0-9A-Fa-f]{14})$"
            },
            "description": "Id of the resumable upload, as returned in the `Location` header of the request that created it."
          }
        ],
        "x-ember-nexus-har-example": [
          {
            "har": {
              "method": "HEAD",
              "url": "https://api.example.com/upload/02IiNr0GOoKiPMM1keIQn6X4HCRG6E9xAcDJ9",
              "httpVersion": "HTTP/1.1",
              "cookies": [],
              "headers": [
                {
                  "name": "Authorization",
                  "value": "Bearer secret-token:PIPeJGUt7c00ENn8a5uDlc"
                }
              ],
              "queryString": [],
              "headersSize": -1,
              "bodySize": -1
            }
          }
        ]
      }
    }
  }
}
