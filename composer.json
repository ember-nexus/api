{
  "type": "project",
  "version": "0.1.32",
  "license": "LicenseRef-Source-First-License-1.1",
  "minimum-stability": "dev",
  "prefer-stable": true,
  "require": {
    "php": ">=8.5",
    "ext-ctype": "*",
    "ext-fileinfo": "*",
    "ext-iconv": "*",
    "antlr/antlr4-php-runtime": "^0.10.0",
    "async-aws/s3": "^3.5",
    "cardinalby/content-disposition": "^1.1",
    "guzzlehttp/guzzle": "^7.10",
    "league/flysystem": "^3.36",
    "league/flysystem-bundle": "^3.7",
    "league/flysystem-ziparchive": "^3.23",
    "mongodb/mongodb": "^2.1",
    "php-amqplib/php-amqplib": "^3.6",
    "predis/predis": "^3.6",
    "ramsey/uuid": "^4.9",
    "symfony/asset": "8.1.*",
    "symfony/console": "8.1.*",
    "symfony/dotenv": "8.1.*",
    "symfony/emoji": "8.1.*",
    "symfony/event-dispatcher": "8.1.*",
    "symfony/filesystem": "8.1.*",
    "symfony/flex": "^2.4",
    "symfony/framework-bundle": "8.1.*",
    "symfony/monolog-bundle": "^4.1",
    "symfony/process": "8.1.*",
    "symfony/runtime": "8.1.*",
    "symfony/stopwatch": "8.1.*",
    "symfony/string": "8.1.*",
    "symfony/yaml": "8.1.*",
    "syndesi/cypher-entity-manager": "^0.2.0",
    "syndesi/elastic-entity-manager": "^0.1.0",
    "syndesi/mongo-entity-manager": "^0.2.0",
    "thecodingmachine/safe": "^v3.3",
    "tuupola/base58": "^2.2"
  },
  "require-dev": {
    "beste/psr-testlogger": "^1.0",
    "brianium/paratest": "^7.24",
    "friendsofphp/php-cs-fixer": "^3.95",
    "infection/infection": "^0.35",
    "phpbench/phpbench": "^1.2",
    "phpmd/phpmd": "^3.0",
    "phpspec/prophecy-phpunit": "^2.1",
    "phpstan/phpstan": "^2.1",
    "phpunit/php-code-coverage": "^14",
    "phpunit/phpunit": "^13",
    "symfony/maker-bundle": "^1.53",
    "symfony/phpunit-bridge": "^7.2",
    "symfony/web-profiler-bundle": "8.1.*",
    "thecodingmachine/phpstan-safe-rule": "^1.4",
    "vimeo/psalm": "^6.18"
  },
  "config": {
    "allow-plugins": {
      "symfony/flex": true,
      "symfony/runtime": true,
      "infection/extension-installer": true,
      "php-http/discovery": true
    },
    "sort-packages": true,
    "process-timeout": 0
  },
  "autoload": {
    "psr-4": {
      "EmberNexusBundle\\": "lib/EmberNexusBundle/src/",
      "App\\": "src/"
    },
    "classmap": [
      "lib/Antlr/dist/"
    ]
  },
  "autoload-dev": {
    "psr-4": {
      "App\\Tests\\": "tests/"
    }
  },
  "replace": {
    "symfony/polyfill-ctype": "*",
    "symfony/polyfill-iconv": "*",
    "symfony/polyfill-php72": "*",
    "symfony/polyfill-php73": "*",
    "symfony/polyfill-php74": "*",
    "symfony/polyfill-php80": "*",
    "symfony/polyfill-php81": "*"
  },
  "scripts": {
    "auto-scripts": {
      "cache:clear": "symfony-cmd",
      "assets:install %PUBLIC_DIR%": "symfony-cmd"
    },
    "post-install-cmd": [
      "@auto-scripts"
    ],
    "post-update-cmd": [
      "@auto-scripts"
    ],
    "test:unit": "php vendor/bin/paratest -p 6 --configuration tests/phpunit.xml.dist",
    "test:unit:test": "php vendor/bin/paratest -p 6 --configuration tests/phpunit.xml.dist --group test",
    "test:end-to-end": "php bin/console cache:clear && ./bin/test-end-to-end-prepare && php vendor/bin/paratest -p 6 --configuration tests/phpunit.end-to-end.xml.dist ./tests/EndToEndTests --exclude-group command && php vendor/phpunit/phpunit/phpunit --configuration tests/phpunit.end-to-end.xml.dist ./tests/EndToEndTests --group command < /dev/null",
    "test:end-to-end:test": "php bin/console cache:clear && ./bin/test-end-to-end-prepare && php vendor/phpunit/phpunit/phpunit --configuration tests/phpunit.end-to-end.xml.dist ./tests/EndToEndTests --group test",
    "test:end-to-end:test-fast": "php vendor/phpunit/phpunit/phpunit --configuration tests/phpunit.end-to-end.xml.dist ./tests/EndToEndTests --group test",
    "test:server": "php vendor/phpunit/phpunit/phpunit --configuration tests/phpunit.server.xml.dist ./tests/ServerTests",
    "test:example-generation-controller": "php bin/console cache:clear && ./bin/test-end-to-end-prepare && php vendor/phpunit/phpunit/phpunit --configuration tests/phpunit.end-to-end.xml.dist ./tests/ExampleGenerationControllerWithDefaultConfiguration && php bin/console cache:clear",
    "test:example-generation-controller:with-different-configuration-1": "API_DOMAIN=${API_DOMAIN_DIFFERENT_CONFIGURATION_1:-http://api-different-configuration-1} php vendor/phpunit/phpunit/phpunit --configuration tests/phpunit.end-to-end.xml.dist ./tests/ExampleGenerationControllerWithDifferentConfiguration1",
    "test:example-generation-controller:with-different-configuration-2": "API_DOMAIN=${API_DOMAIN_DIFFERENT_CONFIGURATION_2:-http://api-different-configuration-2} php vendor/phpunit/phpunit/phpunit --configuration tests/phpunit.end-to-end.xml.dist ./tests/ExampleGenerationControllerWithDifferentConfiguration2",
    "test:example-generation-controller:test-orig": "php bin/console cache:clear && ./bin/test-end-to-end-prepare && php vendor/phpunit/phpunit/phpunit --configuration tests/phpunit.end-to-end.xml.dist ./tests/ExampleGenerationControllerWithDefaultConfiguration --group test && php bin/console cache:clear",
    "test:example-generation-controller:test": "php vendor/phpunit/phpunit/phpunit --configuration tests/phpunit.end-to-end.xml.dist ./tests/ExampleGenerationControllerWithDefaultConfiguration --group test",
    "test:example-generation-command": "php bin/console cache:clear && php bin/console cache:clear --env=prod && ./bin/test-end-to-end-command-prepare && php vendor/phpunit/phpunit/phpunit --configuration tests/phpunit.end-to-end.xml.dist ./tests/ExampleGenerationCommand && php bin/console cache:clear && php bin/console cache:clear --env=prod",
    "test:coverage:xml": "export XDEBUG_MODE=coverage && php ./vendor/phpunit/phpunit/phpunit --configuration tests/phpunit.xml.dist --coverage-clover coverage.xml",
    "test:coverage:html": "export XDEBUG_MODE=coverage && php ./vendor/phpunit/phpunit/phpunit --configuration tests/phpunit.xml.dist --coverage-html ./tmp",
    "test:mutant": "export XDEBUG_MODE=coverage && php vendor/infection/infection/bin/infection --configuration=tests/infection.json5 --threads=max",
    "cs:list": "php vendor/friendsofphp/php-cs-fixer/php-cs-fixer fix --config=tests/.php-cs-fixer.dist.php --allow-risky=yes --dry-run",
    "cs:fix": "php vendor/friendsofphp/php-cs-fixer/php-cs-fixer fix --config=tests/.php-cs-fixer.dist.php --allow-risky=yes",
    "psalm": "php vendor/bin/psalm --config=tests/psalm.xml --show-info=true --no-cache",
    "psalm:fix-dry": "php vendor/bin/psalm --config=tests/psalm.xml --alter --issues=MissingParamType,MissingReturnType,InvalidReturnType,InvalidNullableReturnType,MismatchingDocblockParamType --dry-run",
    "psalm:fix-apply": "php vendor/bin/psalm --config=tests/psalm.xml --alter --issues=MissingParamType,MissingReturnType,InvalidReturnType,InvalidNullableReturnType,MismatchingDocblockParamType",
    "phpstan": "vendor/bin/phpstan --configuration=tests/phpstan.neon",
    "mess": "vendor/bin/phpmd analyze --ruleset=tests/phpmd.xml -- src lib tests",
    "yml:lint": "docker run --rm -it -v \"$(pwd):/data\" cytopia/yamllint --config-file=tests/.yamllint .",
    "markdown:lint": "docker run --rm -it -v \"$(pwd):/work\" tmknom/markdownlint '**/*.md' --config tests/.markdownlintrc --ignore vendor --ignore CHANGELOG.md --ignore var --ignore tmp",
    "build:antlr": "./bin/build-antlr.sh",
    "docs:serve": "docker run --rm -d -p 3000:3000 -v \"$(pwd)/docs:/docs\" sujaykumarh/docsify serve"
  },
  "conflict": {
    "symfony/symfony": "*"
  },
  "extra": {
    "symfony": {
      "allow-contrib": false,
      "require": "8.1.*"
    }
  }
}
