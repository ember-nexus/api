{
  "debug": true,
  "steps": [
    {
      "type": "elasticsearch-query-dsl-mixin",
      "query": {
        "query": {
          "match": {
            "description": "lily"
          }
        },
        "highlight": {
          "pre_tags": [
            "<mark>"
          ],
          "post_tags": [
            "</mark>"
          ],
          "fields": {
            "description": {
              "number_of_fragments": 1
            }
          },
          "encoder": "html"
        }
      },
      "parameters": {
        "nodeTypes": [
          "Plant"
        ],
        "pageSize": 3
      }
    },
    {
      "type": "element-hydration"
    }
  ]
}
