{
  "version": "0.1.34",
  "pageSize": {
    "min": 5,
    "default": 25,
    "max": 100
  },
  "register": {
    "enabled": true,
    "uniqueIdentifier": "email",
    "uniqueIdentifierRegex": "/^[^\\s@]+@[^\\s@]+$/"
  },
  "expression": {
    "enabled": true,
    "maxLength": 10240
  },
  "file": {
    "maxFileSizeInBytes": 10737418240,
    "uploadExpiresAfterFirstRequestInSeconds": 10800,
    "uploadMinChunkSizeInBytes": 5242880,
    "uploadMaxChunkSizeInBytes": 105906176
  }
}