<?xml version="1.0" encoding="UTF-8"?>
<!-- https://phpunit.readthedocs.io/en/latest/configuration.html -->
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../vendor/phpunit/phpunit/phpunit.xsd" backupGlobals="false" colors="true" failOnEmptyTestSuite="true" bootstrap="bootstrap.php" cacheDirectory=".phpunit.cache">
  <php>
    <ini name="display_errors" value="1"/>
    <ini name="error_reporting" value="-1"/>
    <server name="APP_ENV" value="test" force="true"/>
    <server name="SHELL_VERBOSITY" value="-1"/>
  </php>
  <testsuites>
    <testsuite name="Project Test Suite">
      <directory>EndToEndTests</directory>
    </testsuite>
  </testsuites>
  <groups>
    <exclude>
      <group>command</group>
      <group>anonymous-readonly-true</group>
      <group>anonymous-readonly-false</group>
    </exclude>
  </groups>
  <source>
    <include>
      <directory suffix=".php">../src</directory>
      <directory suffix=".php">../lib/EmberNexusBundle</directory>
    </include>
  </source>
</phpunit>
