# Used only by the ci-docs pipeline. Packages an already-built `dist/` (astro build output, built
# exactly once in a separate job and passed in as the `dist` build-context) into a plain Caddy
# image. Kept separate from the main Dockerfile so each arch's image build is cheap (no
# node/pnpm/pnpm install) - the Astro build itself is architecture-independent static output and
# only needs to happen once.
FROM caddy:2.11.4-alpine
COPY --from=dist . /srv
COPY --from=caddyconfig Caddyfile /etc/caddy/Caddyfile
EXPOSE 80
